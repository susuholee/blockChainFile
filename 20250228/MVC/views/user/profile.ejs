<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>회원 정보 수정</h1>
    <form action="./update" method="post">
        <label for="">아이디</label>
        <input type="text" name="uid" value="<%= user.uid %>" readonly>

        <label for="">닉네임</label>
        <input type="text" name="newUsername"  value="<%= user.username %>">

        <label for="">새로운 비밀번호</label>
        <input type="password" name="newUpw" placeholder="새로운 비밀번호를 입력하세요...">
        
        <button>저장하기</button>
        <button>탈퇴하기</button>
    </form> 
</body>
</html>