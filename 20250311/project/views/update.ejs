<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <form action="/update" method="post" id="update_form">
        <%- include('header') %>
        <label for="">제목</label>
        <input type="text" name="title" value="<%= data.title %>">
        <label for="">내용</label>
        <input type="text" name="content" value="<%= data.content %>">
        <button>저장하기</button>
    </form>
</body>
<script>
    update_form.onsubmit = async (e) => {
        e.preventDefault();
        console.log(e.target.value);
        const { title: { value: titleValue }, content: { value: contentValue } } = e.target;
        console.log(titleValue);
        console.log(contentValue);
        
        const { data } = await axios.put('/update', { title: titleValue, content: contentValue });
        console.log(data);
        
        if (data.state === 200) {
            location.href = "/view";
        } else {
            location.href = "/error";
        }
    };
</script>
</html>
