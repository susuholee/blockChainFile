<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>수호 커피 게시판입니다</h1>
    <div class="container">
        <ul>
            <% for(let i = 0; i < coffe.length; i++) {%> 
                <li>
                    <span><%= coffe[i].title %> </span>
