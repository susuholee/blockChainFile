<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>회원가입</title>
    <link rel="stylesheet" href="/public/signup.css">
</head>
<body>
    <%- include("../common/header") %>
    <form id="signup_form">
        <label for="">아이디</label>
        <input type="text" name="uid">
        <label for="">비밀번호</label>
        <input type="text" name="upw">
        <label for="">이름</label>
        <input type="text" name="uname">

        <button>회원가입</button>
    </form>
</body>
<script>
    signup_form.onsubmit = async (e) => {
        // 여기서 빈값 체크를 하고 요청을 보내야한다
        // 교차검증을 해서 프론트도 값의 검증
        // 백엔드도 값 검증

        e.preventDefault();
        const {
            uid : {value : uidValue}, 
            upw : {value : upwValue}, 
            uname : {value : unameValue} 
    } = e.target;
    console.log(uidValue, upwValue, unameValue);        
    const { data } = await axios.post('/user/signup', {uidValue, upwValue, unameValue});
    console.log(data);
    if(data.state === 200){
        location.href = "/user/login"
    } else if (data.state === 400) {
        alert('중복 아이디 회원가입 입니다.')
    } else {
        alert('빈값 없게 작성해주세요')
    }
}
</script>
</html>