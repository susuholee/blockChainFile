<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>회원 가입</title>
</head>
<body>
    <%- include('header') %>
    <form id="signup_form">
        <label for="">아이디</label>
        <input type="text" name="uid">
        <label for="">비밀번호</label>
        <input type="text" name="upw">
        <label for="">성명</label>
        <input type="text" name="name">
        <label for="">닉네임</label>
        <input type="text" name="nick">
        <label for="">프로필 이미지</label>
        <input type="file" name="image">
        <button>회원 가입</button>
    </form>
</body>
<script>
    signup_form.onsubmit = async (e) => {
        e.preventDefault();
        const {uid, upw, name, nick, image} = e.target;
        const form = new FormData();
        // form 데이터의 객체의 형식을 생성
        // append 키와 값을 추가 생성한 form 객체에
        form.append("uid" , uid.value);
        form.append("upw" , upw.value);
        form.append("name" , name.value);
        form.append("nick" , nick.value);
        form.append("image" , image.files[0]);

        const {data} = await axios.post('/signup', form, {
            headers : {
                'Content-type' : 'multipart/form-data'
            }
        });
        if(data.state === 200) {
            location.href = "/"
        }
    }   
</script>
</html>